# Server-only. Never prefix secrets with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Supabase: publishable values are safe for the browser. Keep the secret key
# server-only; it is needed for durable audit-log and case storage writes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Required to enable the remaining live sponsor integrations.
# Nutrient products use separate credentials. Do not reuse these interchangeably.
NUTRIENT_DWS_PROCESSOR_API_KEY=
NUTRIENT_DWS_EXTRACTION_API_KEY=
SERPAPI_KEY=
FOXIT_CLIENT_ID=
FOXIT_CLIENT_SECRET=
FOXIT_ESIGN_CLIENT_ID=
FOXIT_ESIGN_CLIENT_SECRET=
